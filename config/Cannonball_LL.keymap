#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>

#define LAYER_DEF 0
#define LAYER_1 1
#define SCROLL 2

/ {
    /* Behaviors */
    // スクロール設定
    msc {
        acceleration-exponent = <0>;      // 0
        time-to-max-speed-ms = <200>;     // 300
        delay-ms = <5>;                   // 10
    };
    behaviors {
        // エンコーダー：キー
        rot_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        // エンコーダー：マウススクロール 
        rot_msc: sensor_rotate_msc {
             compatible = "zmk,behavior-sensor-rotate-var";
             #sensor-binding-cells = <2>;
             tap-ms = <20>;
             bindings = <&msc>, <&msc>;
        };

        // エンコーダー：マウススクロール(MOVE_Y)
        scroll_move_y: sensor_rotate_msc_for_move_y {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(20)>, <&msc MOVE_Y(-20)>;
            // tap-ms下限メモ Yの値で可変: Y(15) <81>, Y(20) <65>, Y(25) <49>
            tap-ms = <65>;
        };

        // エンコーダー：マウススクロール(MOVE_X)
        scroll_move_x: sensor_rotate_msc_for_move_x {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_X(20)>, <&msc MOVE_X(-20)>;
            // tap-ms下限メモ Xの値で可変: X(15) <81>, X(20) <65>, X(25) <49>
            tap-ms = <65>;
        };
    };

    /* キーマップ */
    keymap {
        compatible = "zmk,keymap";

        // default layer
    	LAYER_DEF {
            bindings = <
                // Order when USB is on top
                // Keys (Upper-right to Lower-left)
                &kp LSHIFT &kp LC(Y) &kp LC(C) &kp F3
                &mkp MB1   &kp LCMD  &mkp MB1  &kp F2
                &kp LCTRL  &kp LC(Z) &kp LC(P) &kp F1
                // Mouse (Left, Right)
                &mkp MB1 &mkp MB2
                // Stick (Up, Left, Down, Right)
                &kp LG(UP) &kp LG(LS(TAB)) &kp LG(DOWN) &kp LG(TAB)
                // Lever (Left-side-left to Right-side-right)
                &kp LG(LS(LEFT)) &kp LG(D)     &kp LG(LS(RIGHT))
                &kp LG(LC(LEFT)) &kp LG(LC(D)) &kp LG(LC(RIGHT))
                // Side (Upper-left, Lower-left, Upper-right, Lower-right)
                &mkp MB3 &kp BSPC &kp LC(F) &to LAYER_1
                // Back (Upper, Lower)
                &bt BT_SEL 0 &bt BT_SEL 1
    	    >;
            // Encoder ( Upper CCW CW, Middle Left(UP) Right(Down), Left(UP) Right(Down))
            sensor-bindings = <&kp TAB &kp LS(TAB)>, <&scroll_move_y>, <&scroll_move_x>;
    	};

        // layer 1
    	LAYER_1 {
            bindings = <
                // Order when USB is on top
                // Keys (Upper-right to Lower-left)
                &kp LSHIFT &kp LC(Y) &kp LC(C) &kp F3
                &mkp MB1   &kp LCMD  &mkp MB1  &kp F2
                &kp LCTRL  &kp LC(Z) &kp LC(P) &kp F1
                // Mouse (Left, Right)
                &mkp MB1 &mkp MB2
                // Stick (Up, Left, Down, Right)
                &kp LG(UP) &kp LG(LS(TAB)) &kp LG(DOWN) &kp LG(TAB)
                // Lever (Left-side-left to Right-side-right)
                &kp LG(LS(LEFT)) &kp LG(D)     &kp LG(LS(RIGHT))
                &kp LG(LC(LEFT)) &kp LG(LC(D)) &kp LG(LC(RIGHT))
                // Side (Upper-left, Lower-left, Upper-right, Lower-right)
                &mkp MB3 &kp BSPC &kp LC(F) &to LAYER_DEF
                // Back (Upper, Lower)
                &bt BT_SEL 0 &bt BT_SEL 1
    	    >;
            // Encoder ( Upper CCW CW, Middle Left(UP) Right(Down), Left(UP) Right(Down))
            sensor-bindings = <&kp TAB &kp LS(TAB)>, <&scroll_move_y>, <&scroll_move_x>;
    	};

        // BT設定、スクロールレイヤー
        SETTINGS {
            bindings = <
                // Key
                &none &none &none &none
                &none &mo SCROLL &none &none
                &none &none &none &none
                // Mouse
                &none &none
                // Stick
                &none &none &none &none
                // Lever
                &none &none &none
                &none &none &none
                // Side
                &none &none &none &none
                // Back
                &bt BT_CLR_ALL &bt BT_CLR
    	    >;
            // Encoder ( Upper CCW CW, Middle Left(UP) Right(Down), Left(UP) Right(Down))
            sensor-bindings = <&kp TAB &kp LS(TAB)>, <&scroll_move_y>, <&scroll_move_x>;
    	};
    };
};
