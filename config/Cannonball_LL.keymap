#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>

#define LAYER_DEF 0
#define LAYER_01 1
#define SCROLL 2

/ {
    /* Behaviors */
    // スクロール設定
    msc {
        acceleration-exponent = <0>;      // 0
        time-to-max-speed-ms = <0>;       // 300
        delay-ms = <5>;                   // 10
    };
    behaviors {
        // エンコーダー：キー
        rot_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        // エンコーダー：マウススクロール 
        rot_msc: sensor_rotate_msc {
             compatible = "zmk,behavior-sensor-rotate-var";
             #sensor-binding-cells = <2>;
             tap-ms = <20>;
             bindings = <&msc>, <&msc>;
        };

        // エンコーダー：マウススクロール(MOVE_Y)
        scroll_move_y: sensor_rotate_msc_for_move_y {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(25)>, <&msc MOVE_Y(-25)>;
            // tap-ms下限メモ Yの値で可変: Y(15) <81>, Y(20) <65>, Y(25) <49>
            tap-ms = <49>;
        };

        // エンコーダー：マウススクロール(MOVE_X)
        scroll_move_x: sensor_rotate_msc_for_move_x {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_X(25)>, <&msc MOVE_X(-25)>;
            // tap-ms下限メモ Xの値で可変: X(15) <81>, X(20) <65>, X(25) <49>
            tap-ms = <49>;
        };

       // ジョイスティック押し込みの排他処理
       joy_center_gate: behavior_joy_center_gate {
          compatible = "zmk,behavior-hold-tap";
          label = "JOY_CENTER_GATE";
          #binding-cells = <2>;
    
          // [TAP]=中ボタン, [HOLD]=無効化
          bindings = <&none>, <&mkp>;
    
          // センター単独→Tap、方向と同時→Hold側に倒れる
          tapping-term-ms = <180>;
          quick-tap-ms    = <180>;
          flavor = "tap-preferred";
    
          // Stick の Up/Left/Down/Right の "key position"
          // まずは仮で <14 15 16 17>（ズレたら後で直す）
          hold-trigger-key-positions = <14 15 16 17>;
        };
    };

    /* キーマップ */
    keymap {
        compatible = "zmk,keymap";
        kscan = <&kscan0 &joy_click_kscan>;

        // Base Layer
    	LAYER_DEF {
            bindings = <
                // Order when USB is on top
                // Keys (Upper-right to Lower-left)
                &kp LC(V) &kp LC(Y) &kp LC(V) &none
                &mkp MB3  &kp LCMD  &mkp MB3  &none
                &kp LC(C) &kp LC(Z) &kp LC(C) &none
                // Mouse (Left, Right)
                &mkp MB1 &mkp MB2
                // Stick (Up, Left, Down, Right)
                &msc SCRL_UP &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_RIGHT
                // Lever (Left-side-left to Right-side-right)
                &kp LG(TAB)      &none         &kp LG(LS(TAB))
                &kp LG(LC(LEFT)) &kp LG(LC(D)) &kp LG(LC(RIGHT))
                // Side (Upper-left, Lower-left, Upper-right, Lower-right)
                &mkp MB3 &to LAYER_01 &none &none
                // Back (Upper, Lower)
                &bt BT_SEL 0 &bt BT_SEL 1
                // Joystick Push
                &joy_center_gate 0 MB3
    	    >;
            sensor-bindings = <&rot_kp LS(TAB) TAB>, <&scroll_move_y>, <&scroll_move_x>;
    	};

        // Layer 01
    	LAYER_01 {
            bindings = <
                // Key
                // Order when USB is on top
                // Keys (Upper-right to Lower-left)
                &kp KP_N3 &kp KP_N6 &kp KP_N9 &kp KP_EQUAL
                &kp KP_N2 &kp KP_N5 &kp KP_N8 &kp KP_N0
                &kp KP_N1 &kp KP_N4 &kp KP_N7 &kp KP_DOT
                // Mouse (Left, Right)
                &mkp MB1 &mkp MB2
                // Stick (Up, Left, Down, Right)
                &kp LG(UP) &kp LG(LS(TAB)) &kp LG(DOWN) &kp LG(TAB)
                // Lever (Left-side-left to Right-side-right)
                &none &none &none
                &none &none &none
                // Side (Upper-left, Lower-left, Upper-right, Lower-right)
                &mkp MB3 &to LAYER_DEF &none &kp KP_N0
                // Back (Upper, Lower)
                &bt BT_SEL 0 &bt BT_SEL 1
                // Joystick Push
                &joy_center_gate 0 MB3
    	    >;

            // Encoder ( Upper CCW CW, Middle Left(UP) Right(Down), Left(UP) Right(Down))
            sensor-bindings = <&rot_kp LS(TAB) TAB>, <&scroll_move_y>, <&scroll_move_x>;
    	};

        // BT設定、スクロールレイヤー
        SETTINGS {
            bindings = <
                // Key
                &none &none &none &none
                &none &mo SCROLL &none &none
                &none &none &none &none
                // Mouse
                &none &none
                // Stick
                &none &none &none &none
                // Lever
                &none &none &none
                &none &none &none
                // Side
                &none &none &none &none
                // Back
                &bt BT_CLR_ALL &bt BT_CLR
                // Joystick Push
                &none
    	    >;
            sensor-bindings = <&rot_kp LEFT RIGHT>, <&scroll_move_y>, <&scroll_move_x>;
    	};
    };
};
